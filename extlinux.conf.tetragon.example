# Example extlinux fragment. Stock stays DEFAULT. The FDT line is the
# point of this file: omitting it makes the loader fall back to a firmware
# DTB with no MGBE node and the board loses its network.
#
# LINUX paths: stock /boot/Image; rebuilt /boot/Image-tetragon.
# FDT path: board -nv DTB that contains the tegra234 MGBE nodes.
# INITRD and APPEND transcribed from a live R36.5 AGX Orin stanza,
# then generalised: root=PARTUUID is board-specific — substitute the
# PARTUUID of the partition that is mounted on / (blkid / findmnt).
# DEFAULT remains primary / stock. A board already running the rebuilt
# kernel may have DEFAULT tetragon; the published recipe does not
# change DEFAULT and does not recommend making the rebuild the default.

TIMEOUT 30
DEFAULT primary

LABEL primary
	MENU LABEL primary kernel
	LINUX /boot/Image
	INITRD /boot/initrd
	FDT /boot/dtb/kernel_tegra234-p3737-0000+p3701-0005-nv.dtb
	APPEND ${cbootargs} root=PARTUUID=<root-partuuid> rw rootwait rootfstype=ext4 mminit_loglevel=4 console=ttyTCU0,115200 console=ttyAMA0,115200 firmware_class.path=/etc/firmware fbcon=map:0 video=efifb:off console=tty0 efi=runtime nvme.use_threaded_interrupts=1 pci=pcie_bus_perf

LABEL tetragon
	MENU LABEL tetragon kernel
	LINUX /boot/Image-tetragon
	INITRD /boot/initrd
	FDT /boot/dtb/kernel_tegra234-p3737-0000+p3701-0005-nv.dtb
	APPEND ${cbootargs} root=PARTUUID=<root-partuuid> rw rootwait rootfstype=ext4 mminit_loglevel=4 console=ttyTCU0,115200 console=ttyAMA0,115200 firmware_class.path=/etc/firmware fbcon=map:0 video=efifb:off console=tty0 efi=runtime nvme.use_threaded_interrupts=1 pci=pcie_bus_perf
